<?xml version="1.0"?>

<sdf version="1.6">
  <world name="default">

    <physics name="normal" type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>

    <!-- Ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Lighting -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- ArUco marker_23: 着陸目標マーカー（地面中央に固定）-->
    <!-- ドローンカメラがこのマーカーを見下ろし、画像中心に収束する -->
    <include>
      <uri>model://marker_23</uri>
      <pose>0 0 0.001  0 0 0</pose>
    </include>

  </world>
</sdf>
